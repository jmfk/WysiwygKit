{
  "name": "wysiwygkit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/react"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:update-snapshots": "npm run test:visual -- --update-snapshots",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "dev": "vite --host 127.0.0.1 --port 13700 --strictPort",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx}\" \"demos/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx}\" \"demos/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.ts\""
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "dompurify": "3.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.0.0",
    "prettier": "3.10.1",
    "typescript": "^6.0.0",
    "vite": "8.3.8",
    "vitest": "^4.1.0"
  },
  "packageManager": "npm@11.19.1"
}
