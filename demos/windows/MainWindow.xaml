<Window x:Class="WysiwygDemo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WysiwygKit · Windows" Width="1100" Height="800">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="16">
   <TextBlock Text="WysiwygKit · WPF" FontSize="24" Margin="0,0,0,12" />
   <WrapPanel>
    <ComboBox x:Name="Format" Width="130" SelectedIndex="0" SelectionChanged="FormatChanged"><ComboBoxItem>markdown</ComboBoxItem><ComboBoxItem>html</ComboBoxItem><ComboBoxItem>fountain</ComboBoxItem></ComboBox>
    <ComboBox x:Name="Theme" Width="100" SelectedIndex="0" SelectionChanged="ConfigChanged"><ComboBoxItem>system</ComboBoxItem><ComboBoxItem>light</ComboBoxItem><ComboBoxItem>dark</ComboBoxItem></ComboBox>
    <ComboBox x:Name="Locale" Width="100" SelectedIndex="0" SelectionChanged="ConfigChanged"><ComboBoxItem>en</ComboBoxItem><ComboBoxItem>sv</ComboBoxItem><ComboBoxItem>ar</ComboBoxItem></ComboBox>
    <CheckBox x:Name="ReadOnly" Content="Read only" Click="ConfigChanged" Margin="12,0" VerticalAlignment="Center" />
    <Button Content="Export snapshot" Click="Export" Padding="12,6" />
   </WrapPanel>
   <TextBlock x:Name="Status" Margin="0,8" /><TextBlock x:Name="Error" Foreground="DarkRed" TextWrapping="Wrap" />
  </StackPanel>
  <Expander DockPanel.Dock="Bottom" Header="Snapshot" Margin="16"><TextBox x:Name="Output" Height="160" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" /></Expander>
  <ContentControl x:Name="EditorHost" />
 </DockPanel>
</Window>
