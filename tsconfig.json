{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@wysiwygkit/core": [
        "packages/core/src/index.ts"
      ],
      "@wysiwygkit/react": [
        "packages/react/src/index.tsx"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "demos/**/*.ts",
    "demos/**/*.tsx",
    "tests/**/*.ts",
    "*.ts"
  ]
}
