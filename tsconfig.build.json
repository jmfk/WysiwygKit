{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".types",
    "rootDir": "packages"
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/react/src/**/*.tsx"
  ]
}
